# God's Eye View site block for Passive Monitor's Caddyfile. See DEPLOY.md,
# "Upstream's request checks, and what Caddy must do about them".
#
# Replace the domain, and the hash with the output of:
#   docker run --rm caddy:2 caddy hash-password --plaintext 'your-password'
# Then reload Caddy and run the checks under "Verifying a deployment".

godseye.yourdomain.com {
	basicauth {
		viewer <bcrypt-hash>
	}

	reverse_proxy gods-eye-view:4173 {
		# Upstream refuses cost-bearing requests that carry proxy headers, and
		# compares Origin against the plain-http scheme it sees behind Caddy.
		# Caddy adds the X-Forwarded-* trio itself; the rest are removed in
		# case a client or a CDN in front sends them.
		header_up -X-Forwarded-For
		header_up -X-Forwarded-Proto
		header_up -X-Forwarded-Host
		header_up -X-Forwarded-Port
		header_up -X-Real-IP
		header_up -Forwarded
		header_up -Via
		header_up -CF-Connecting-IP
		header_up -CF-Ray
		header_up -Origin
	}

	encode gzip
	log {
		output stdout
	}
}
